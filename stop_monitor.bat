@echo off
chcp 65001 >nul
REM ============================================================
REM   ОСТАНОВКА фонового мониторинга подарков.
REM   ВНИМАНИЕ: завершает ВСЕ процессы python.exe на компьютере.
REM   Если у вас запущены другие скрипты Python — закройте их
REM   вручную через Диспетчер задач, а не этим файлом.
REM ============================================================

echo Останавливаю мониторинг (python.exe)...
taskkill /F /IM python.exe >nul 2>&1
if %errorlevel%==0 (
    echo Готово — мониторинг остановлен.
) else (
    echo Активных процессов python.exe не найдено.
)
echo.
pause >nul
